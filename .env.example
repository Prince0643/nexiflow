# Environment variables for production deployment
# Copy this file to .env and fill in your actual values

# Database Configuration (External MySQL - uses host's database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clockistry_user
DB_PASSWORD=your_db_password
DB_NAME=clockistry

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# CORS - Your production domain
CORS_ORIGIN=https://nexi-flow.com

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Nexiflow <your-email@gmail.com>"

# PayMongo Payment Integration
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret
PAYMONGO_API_URL=https://api.paymongo.com/v1

# External API URL for PayMongo webhooks
EXTERNAL_PAYMONGO_API_URL=https://api.nexi-flow.com

# Frontend URL
FRONTEND_URL=https://nexi-flow.com/

# Billing Scheduler API Key
ROOT_API_KEY=your_secure_billing_api_key_min_32_chars
