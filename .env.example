# Environment variables for production deployment
# Copy this file to .env and fill in your actual values

# Database Configuration (External MySQL - uses host's database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clockistry_user
DB_PASSWORD=your_db_password
DB_NAME=clockistry

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# CORS - Your production domain
CORS_ORIGIN=https://nexi-flow.com

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Nexiflow <your-email@gmail.com>"

# External Payment Backend URL
EXTERNAL_PAYMONGO_API_URL=https://api.nexistrydigitalsolutions.com

# Frontend URL
FRONTEND_URL=https://nexi-flow.com/

# Billing Scheduler API Key
ROOT_API_KEY=your_secure_billing_api_key_min_32_chars

# PayPal Configuration
# Get these from https://developer.paypal.com/dashboard/ (Sandbox for testing, Live for production)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Use 'sandbox' for testing, 'live' for production
PAYPAL_ENVIRONMENT=sandbox

# OpenAI (server-side only)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Google Drive (per-company super admin connection)
# Create a Web OAuth client in Google Cloud and set these on the backend.
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret
GOOGLE_DRIVE_REDIRECT_URI=https://nexi-flow.com/api/admin/google-drive/callback
# Random string for signing OAuth state (keep secret)
GOOGLE_DRIVE_OAUTH_STATE_SECRET=your_random_state_secret
# 32-byte encryption key (base64). Example generation (run locally):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_DRIVE_TOKEN_ENC_KEY=your_base64_32_byte_key
GOOGLE_DRIVE_FOLDER_NAME=NexiFlow Screenshots
