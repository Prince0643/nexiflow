{
  "manifest_version": 3,
  "name": "NexiFlow Time Tracker",
  "version": "0.1.1",
  "description": "Track time and optionally capture screenshots for proof-of-work.",
  "permissions": ["storage", "alarms", "desktopCapture", "offscreen", "tabs", "activeTab"],
  "host_permissions": [
    "https://nexi-flow.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NexiFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  }
}
