# ============================================
# Clockistry API Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=clockistry

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ============================================
# PAYMONGO INTEGRATION (via External Backend)
# ============================================

# External PayMongo Backend API URL
EXTERNAL_PAYMONGO_API_URL=https://api.nexistrydigitalsolutions.com

# Your Clockistry domain (must be whitelisted in external backend ALLOWED_ORIGINS)
# The external backend will send webhooks to: https://your-domain.com/api/billing/webhook

# Optional: Webhook secret for verifying webhooks from external backend
# This should match the CLOCKISTRY_WEBHOOK_SECRET configured on the external backend
# EXTERNAL_PAYMONGO_WEBHOOK_SECRET=your_shared_secret_here

# Note: No direct PayMongo keys needed - all payment processing goes through external backend
# The external backend handles:
#   - PAYMONGO_SECRET_KEY
#   - PAYMONGO_WEBHOOK_SECRET
#   - Tax calculations
#   - Multiple payment methods (card, gcash, maya, grabpay, qrph, etc.)

# ============================================
# OTHER INTEGRATIONS
# ============================================

# Example other configurations
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
