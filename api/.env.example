# ============================================
# Clockistry API Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=clockistry

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ============================================
# EXTERNAL PAYMENT INTEGRATION
# ============================================

# External PayMongo Backend API URL
EXTERNAL_PAYMONGO_API_URL=https://api.nexistrydigitalsolutions.com

# Your Clockistry domain (must be whitelisted in external backend ALLOWED_ORIGINS)
# The external backend will send webhooks to: https://your-domain.com/api/billing/webhook

# Note: All payment processing goes through external backend
# The external backend handles:
#   - PayMongo API keys and secrets
#   - Tax calculations
#   - Multiple payment methods (card, gcash, maya, grabpay, qrph, etc.)

# ============================================
# OTHER INTEGRATIONS
# ============================================

# Example other configurations
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
